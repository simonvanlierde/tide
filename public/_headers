# Cloudflare Pages response headers. All cycle history lives in localStorage on
# this origin, so keep the page unframeable and the network surface closed.
# NOTE: script-src allows 'unsafe-inline' for the theme script in index.html;
# hash it (and check the hash in CI) if the inline script ever stabilises.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
