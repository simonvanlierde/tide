{
  "name": "tide-period-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm bundle:check",
    "dev": "vite",
    "typecheck": "tsc -b --pretty false",
    "build": "vite build",
    "bundle:check": "node scripts/checkBundleBudget.mjs",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "overrides": {
      "serialize-javascript": "^7.0.5"
    }
  }
}
