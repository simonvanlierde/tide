{
  "name": "tide-period-tracker",
  "version": "0.4.0",
  "description": "Privacy-first, local-first period tracker PWA — React + TypeScript + Vite, data stays in the browser",
  "license": "MIT",
  "author": "Simon van Lierde <90462640+simonvanlierde@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simonvanlierde/tide.git"
  },
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.13.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "backtest": "node scripts/backtestPredictor.mjs",
    "budget": "node scripts/checkBundleBudget.mjs",
    "build": "vite build",
    "check": "biome check && knip",
    "coverage": "vitest run --coverage --coverage.reporter=text",
    "dev": "vite",
    "fix": "biome check --write",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc"
  },
  "knip": {
    "ignoreDependencies": [
      "@j178/prek"
    ]
  },
  "dependencies": {
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.5.15",
    "@j178/prek": "^0.5.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.3",
    "knip": "^6.41.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
