{
  "name": "tide-period-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=26",
    "pnpm": ">=11"
  },
  "scripts": {
    "prepare": "lefthook install",
    "check": "pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm build && pnpm bundle:check",
    "dev": "vite",
    "typecheck": "tsc -b --pretty false",
    "build": "vite build",
    "bundle:check": "node scripts/checkBundleBudget.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "preview": "vite preview",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest --run",
    "test:coverage": "NODE_OPTIONS=--no-experimental-webstorage vitest --run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.2",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.9",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
