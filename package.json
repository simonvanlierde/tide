{
  "name": "tide-period-tracker",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=26",
    "pnpm": ">=11"
  },
  "scripts": {
    "prepare": "lefthook install",
    "check": "pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm build && pnpm bundle:check",
    "dev": "vite",
    "typecheck": "tsc -b --pretty false",
    "build": "vite build && node scripts/writeCspHeaders.mjs",
    "bundle:check": "node scripts/checkBundleBudget.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "preview": "vite preview",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest --run",
    "test:coverage": "NODE_OPTIONS=--no-experimental-webstorage vitest --run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.1",
    "lefthook": "^2.1.16",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  }
}
